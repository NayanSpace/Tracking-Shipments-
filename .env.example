# ─── Database (Neon.tech) ────────────────────────────────────────────────────
# Direct connection (no -pooler) — used by Alembic migrations
DATABASE_DIRECT_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Pooled connection — used by the app at runtime
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-generated-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── App ──────────────────────────────────────────────────────────────────────
# Use "development" locally, "production" on Render
ENVIRONMENT=development
DEBUG=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:5173 — Production: your Render frontend URL
FRONTEND_URL=http://localhost:5173

# ─── Render (optional) ───────────────────────────────────────────────────────
PORT=8000
